# ==========================================
# TS EYEWEAR - Backend Environment Variables
# ==========================================

# 1. Configurações do Servidor Express
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://tsjoculos.com
COOKIE_DOMAIN=.tsjoculos.com

# 2. Segurança e Sessões Administrativas (OBRIGATÓRIO)
# Chave criptográfica para assinatura e verificação dos tokens JWT das sessões exclusivas.
# Gere uma chave longa e aleatória (ex: openssl rand -base64 32).
JWT_SECRET=coloque_sua_chave_jwt_secreta_aqui
JWT_EXPIRES_IN=7d

# 3. Administrador Inicial (Utilizado no seed do banco: npm run seed)
# Nunca deixe credenciais no código. Preencha aqui para criar o primeiro administrador com hash Bcrypt no banco.
ADMIN_DEFAULT_NAME="Administrador TS EYEWEAR"
ADMIN_DEFAULT_EMAIL=admin@seudominio.com.br
ADMIN_DEFAULT_PASSWORD=SuaSenhaForteAqui123!

# 4. Banco de Dados PostgreSQL no Supabase (Prisma ORM)
DATABASE_URL="postgres://postgres.[REF]:[SENHA]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgres://postgres.[REF]:[SENHA]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# 5. Supabase Storage & API Keys (Opcional - mídia primária usa Vercel Blob)
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_ANON_KEY="sua_chave_anonima_supabase"
SUPABASE_SERVICE_ROLE_KEY="sua_chave_service_role_supabase"
SUPABASE_BUCKET_IMAGENS="produtos-imagens"
SUPABASE_BUCKET_VIDEOS="produtos-videos"

# 6. Vercel Blob Storage (Armazenamento primário de fotos de produtos e banners)
BLOB_STORE_ID="store_seu_store_id"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_aqui"
