# Servidor Express TS EYEWEAR
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Autenticação JWT Admin
JWT_SECRET=sua_chave_secreta_jwt_aqui
JWT_EXPIRES_IN=7d

# Banco de Dados PostgreSQL no Supabase
DATABASE_URL="postgres://postgres.[REF]:[SENHA]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgres://postgres.[REF]:[SENHA]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Storage & API Keys
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_ANON_KEY="sua_chave_anonima_supabase"
SUPABASE_SERVICE_ROLE_KEY="sua_chave_service_role_supabase"

# Vercel Blob Storage
BLOB_STORE_ID="store_seu_store_id"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_aqui"
